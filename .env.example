# ==========================================
# NitroStack Server Configuration
# ==========================================
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=gemini

# ==========================================
# Core AI & Security Gate Credentials (Required)
# ==========================================
# Google Gemini API Key for autonomous agentic SRE reasoning
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Cryptographic HMAC Secret for Zero-Trust Execution Gate
# Generate via: openssl rand -hex 32
ZERO_TRUST_SECRET=your_zero_trust_hmac_secret_here

# ==========================================
# Enterprise Tool Integrations (Optional Real Connections)
# ==========================================
# GitHub Integration
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_REPO=organization/repository-name

# Jira Integration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=sre-team@yourcompany.com
JIRA_API_TOKEN=your_jira_api_token

# Datadog Integration
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key

# Slack Incident Channel Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# ==========================================
# Server Transport Configuration (Optional)
# ==========================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
